{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Launch ControlBuddy",
      "request": "launch",
      "type": "chrome",
      "url": "http://localhost:3000/",
      "preLaunchTask": "npm: start",
      "webRoot": "${workspaceFolder}"
    },
    {
      "name": "Launch ControlBuddy - QuadHelp",
      "request": "launch",
      "type": "chrome",
      "url": "http://localhost:3000/?page=QuadHelp",
      "preLaunchTask": "npm: start",
      "webRoot": "${workspaceFolder}"
    },
    {
      "name": "Launch Node Static Server",
      "request": "launch",
      "type": "node",
      "program": "${workspaceFolder}/scripts/server.js",
      "cwd": "${workspaceFolder}",
      "env": {
        "PORT": "3000"
      },
      "console": "integratedTerminal",
      "serverReadyAction": {
        "pattern": "Serving .* at http://localhost:(\\d+)/",
        "uriFormat": "http://localhost:%s/",
        "action": "openExternally"
      }
    },
    {
      "name": "Launch Chrome against localhost",
      "request": "launch",
      "type": "chrome",
      "url": "http://localhost:8080",
      "webRoot": "${workspaceFolder}"
    }
  ]
}